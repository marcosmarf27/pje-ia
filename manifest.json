{
  "manifest_version": 3,
  "name": "TecJustiça PJe — Análise de Processos",
  "version": "0.51.2",
  "description": "Chat com IA (Claude, Gemini ou GPT) sobre os autos do PJe de qualquer tribunal: selecione peças e converse. Por TecJustiça.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.jus.br/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jus.br/*"
      ],
      "js": [
        "src/pje.js",
        "src/caso.js",
        "src/zip.js",
        "src/exportar.js",
        "src/precatoria.js",
        "src/prompts.js",
        "src/modelos.js",
        "src/docx-importar.js",
        "src/tour.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "src/fontes.css",
        "vendor/fontes/*.woff2",
        "icons/icon48.png",
        "src/ocr-render.html",
        "src/mapa.html",
        "src/editor.html",
        "src/help.html"
      ],
      "matches": [
        "https://*.jus.br/*"
      ]
    }
  ],
  "action": {
    "default_title": "TecJustiça PJe — configurar e usar",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
