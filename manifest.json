{
  "manifest_version": 3,
  "name": "TecJustiça PJe — Análise de Processos",
  "version": "0.21.0",
  "description": "Chat com IA (Claude, Gemini ou GPT) sobre os autos do PJe de qualquer tribunal: selecione peças e converse. Por TecJustiça.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://*.jus.br/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.mistral.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://*.jus.br/*"],
      "js": [
        "src/pje.js",
        "src/zip.js",
        "src/exportar.js",
        "src/prompts.js",
        "src/modelos.js",
        "src/texto.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "icons/icon48.png",
        "src/mapa.html",
        "src/editor.html",
        "src/help.html",
        "src/extrator.html",
        "src/texto.html"
      ],
      "matches": ["https://*.jus.br/*"]
    }
  ],
  "action": {
    "default_title": "TecJustiça PJe — configurar e usar",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
